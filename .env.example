# Connection string do Neon (painel do Neon > Connect). Use a URL com ?sslmode=require
DATABASE_URL="postgresql://USUARIO:SENHA@ep-xxxx.sa-east-1.aws.neon.tech/neondb?sslmode=require"
# Segredo usado para assinar os tokens JWT (troque por um valor longo e aleatório)
JWT_SECRET="troque-por-um-segredo-longo"
PORT=3000
# Banco usado pelos testes automatizados (pode ser um branch "test" no Neon). Os testes APAGAM os dados desse banco.
DATABASE_URL_TEST="postgresql://USUARIO:SENHA@ep-yyyy.sa-east-1.aws.neon.tech/neondb?sslmode=require"
